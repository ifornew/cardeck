<?xml version="1.0" encoding="utf-8"?>
<!-- CarPlay 侧栏（左侧竖条）：顶部时间+电量，中部运行中应用，底部回桌面。
     尺寸用 dp：数值 = 设计原型 px ÷ 2.625（设计基准 1160×540@420dpi——
     dock 42dp=110px、时钟 22px，见 design/launcher-proto.html）。dock 虚拟屏
     密度由 SessionController 按画布短边等比下发（VirtualLauncher.DOCK_WIDTH_DP
     注释）：高分辨率车机上随密度等比放大，占比与奥迪基准一致。
     字号不在 XML 里写死：DockActivity 按「设计 px × designScale」以 PX 设置
     （不用 sp——dock 是像素级设计画布，不跟随手机字体缩放）。
     壁纸：DockActivity 在代码里往 dockWallpaper 塞「全流画布切片」（与桌面
     同源同路径，交界连续）；scrim 20% 黑压住壁纸保证内容可读。
     窗口必须不透明——半透明窗口下系统会往这块虚拟屏合成手机自身壁纸
     （曾导致 dock 显示手机壁纸、与桌面壁纸错位的根因）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_window_bg">

    <ImageView
        android:id="@+id/dockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="1.90dp"
        android:paddingRight="1.90dp"
        android:paddingTop="3.05dp"
        android:paddingBottom="3.05dp">

    <TextView
        android:id="@+id/dockClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:letterSpacing="0.03"
        android:textColor="@color/car_text_strong"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <!-- CarPlay 状态行：信号格 + 电池图标（原生不显示百分比：只有图标）。
         字形单色跟随主题；充电时电池变 iOS 绿并在电池内部显示白色闪电。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.29dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dockSignal"
            android:layout_width="wrap_content"
            android:layout_height="5.33dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <View
                android:layout_width="0.76dp"
                android:layout_height="2.29dp"
                android:layout_marginEnd="0.57dp"
                android:background="@drawable/bg_signal_bar" />

            <View
                android:layout_width="0.76dp"
                android:layout_height="3.05dp"
                android:layout_marginEnd="0.57dp"
                android:background="@drawable/bg_signal_bar" />

            <View
                android:layout_width="0.76dp"
                android:layout_height="4.19dp"
                android:layout_marginEnd="0.57dp"
                android:background="@drawable/bg_signal_bar" />

            <View
                android:layout_width="0.76dp"
                android:layout_height="5.33dp"
                android:background="@drawable/bg_signal_bar" />
        </LinearLayout>

        <!-- Wi-Fi（连着车机热点时显示，对应原生 CarPlay 状态栏的 Wi-Fi 图标） -->
        <ImageView
            android:id="@+id/dockWifi"
            android:layout_width="3.81dp"
            android:layout_height="2.86dp"
            android:layout_marginStart="2.29dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wifi"
            android:tint="@color/car_text_strong"
            android:visibility="gone" />

        <!-- 电池：自绘字形（描边/填充/正极/充电闪电，见 BatteryGlyphView） -->
        <io.github.shaonialife.cardeck.launcher.BatteryGlyphView
            android:id="@+id/dockBattery"
            android:layout_width="9.14dp"
            android:layout_height="4.57dp"
            android:layout_marginStart="2.29dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dockApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.38dp"
        android:layout_marginBottom="1.52dp"
        android:background="@color/car_divider_dim" />

    <ImageView
        android:id="@+id/dockHome"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="回到桌面"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dock_home"
        android:tint="@color/car_icon" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- CarPlay 底部 dock（竖屏车机时使用）：⌂ | 运行中应用横排 | 时间/电量。
     尺寸用 dp：数值 = 设计原型 px ÷ 2.625（设计基准 1160×540@420dpi；dock 密度
     随画布短边等比下发——见 activity_dock_sidebar 注释）。
     字号不在 XML 里写死：DockActivity 按「设计 px × designScale」以 PX 设置。
     壁纸：DockActivity 往 dockWallpaper 塞「全流画布切片」（与桌面同源同路径）；
     窗口不透明（半透明窗口会透出系统合成的手机壁纸——见 activity_dock_sidebar 注释）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_window_bg">

    <ImageView
        android:id="@+id/dockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="1.90dp"
        android:paddingRight="3.05dp"
        android:paddingTop="1.52dp"
        android:paddingBottom="1.52dp">

        <ImageView
            android:id="@+id/dockHome"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="回到桌面"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_home"
            android:tint="@color/car_icon" />

        <View
            android:layout_width="0.38dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2.29dp"
            android:layout_marginTop="2.29dp"
            android:layout_marginBottom="2.29dp"
            android:background="@color/car_divider_dim" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.29dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dockApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="3.81dp">

            <TextView
                android:id="@+id/dockClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:letterSpacing="0.03"
                android:textColor="@color/car_text_strong"
                android:textStyle="bold" />

            <!-- CarPlay 状态行：信号格 + 电池图标 + 百分比。
                 宽度 wrap_content，DockActivity 按时钟文字宽度等比缩放本行。 -->
            <LinearLayout
                android:id="@+id/dockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/dockSignal"
                    android:layout_width="wrap_content"
                    android:layout_height="5.33dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0.76dp"
                        android:layout_height="2.29dp"
                        android:layout_marginEnd="0.57dp"
                        android:background="@drawable/bg_signal_bar" />

                    <View
                        android:layout_width="0.76dp"
                        android:layout_height="3.05dp"
                        android:layout_marginEnd="0.57dp"
                        android:background="@drawable/bg_signal_bar" />

                    <View
                        android:layout_width="0.76dp"
                        android:layout_height="4.19dp"
                        android:layout_marginEnd="0.57dp"
                        android:background="@drawable/bg_signal_bar" />

                    <View
                        android:layout_width="0.76dp"
                        android:layout_height="5.33dp"
                        android:background="@drawable/bg_signal_bar" />
                </LinearLayout>

                <!-- 电池：自绘字形（描边/填充/正极/充电闪电，见 BatteryGlyphView） -->
                <io.github.shaonialife.cardeck.launcher.BatteryGlyphView
                    android:id="@+id/dockBattery"
                    android:layout_width="9.14dp"
                    android:layout_height="4.57dp"
                    android:layout_marginStart="2.29dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

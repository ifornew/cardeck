<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="13dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="11dp"
        android:text="车机界面与默认壁纸的明暗外观。切换立即生效；自定义壁纸不受影响。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="外观主题"
        android:textColor="@color/car_text_primary"
        android:textSize="14sp" />

    <!-- 三档等分宽度（与「显示」面板的帧率档位同一套样式），窄屏不会撑出面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnThemeAuto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_sel"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="自动"
            android:textColor="@color/car_segment_sel_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnThemeDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="白天"
            android:textColor="@color/car_text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnThemeNight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="黑夜"
            android:textColor="@color/car_text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/themeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="「自动」当前跟随手机系统的深色/浅色设置；车机昼夜检测信号接入后改为优先车机信号。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="让镜像到车机的应用（高德车机版等）也跟随昼夜"
        android:textColor="@color/car_text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="车机里的应用是手机上的原样镜像，它们只读手机系统的深浅色，本应用的主题切不到它们。开启后，选「白天/黑夜」时会通过 Shizuku 同步切换手机系统的深色开关；选「自动」不动系统。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnThemeSyncSystem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_segment"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:text="同步系统深色：关"
        android:textColor="@color/car_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="说明：主题只影响车机侧界面（桌面、dock、仪表盘卡片、设置页）。手机端界面固定为深色。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />
</LinearLayout>

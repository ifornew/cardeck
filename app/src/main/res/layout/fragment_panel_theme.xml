<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="13dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="11dp"
        android:text="车机界面与默认壁纸的明暗外观。切换立即生效；自定义壁纸不受影响。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="外观主题"
        android:textColor="@color/car_text_primary"
        android:textSize="14sp" />

    <!-- 三档等分宽度（与「显示」面板的帧率档位同一套样式），窄屏不会撑出面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnThemeAuto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_sel"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="自动"
            android:textColor="@color/car_segment_sel_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnThemeDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="白天"
            android:textColor="@color/car_text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnThemeNight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="黑夜"
            android:textColor="@color/car_text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/themeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="「自动」优先跟随车机传来的昼夜信号；未连接车机或未收到信号时跟随手机系统的深色/浅色设置。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="高德车机版昼夜跟随"
        android:textColor="@color/car_text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="高德车机版会直接跟随「外观主题」和车机昼夜信号（通过高德官方广播接口即时切换，无需重启应用）；断开连接后恢复高德自己的「自动」。此功能始终开启。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="同步手机系统深色（其他镜像应用）"
        android:textColor="@color/car_text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="车机里的应用是手机上的原样镜像，多数只读手机系统的深浅色。开启后，选「白天/黑夜」以及「自动」收到车机昼夜信号时，都会通过 Shizuku 切换手机系统的深色开关（断开连接后还原原档位）；「自动」且没有车机信号时不动系统。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnThemeSyncSystem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_segment"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:text="同步系统深色：关"
        android:textColor="@color/car_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="说明：主题只影响车机侧界面（桌面、dock、仪表盘卡片、设置页）。手机端界面固定为深色。"
        android:textColor="@color/car_text_tertiary"
        android:textSize="12sp" />
</LinearLayout>

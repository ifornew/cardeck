<?xml version="1.0" encoding="utf-8"?>
<!-- 仪表盘模式（分屏）右侧面板：上=导航快捷入口卡（回家/回单位），下=音乐控制卡。
     音乐卡形态：四周边距 + 圆角（代码设置 outline 裁剪）+ 背景=该区域壁纸的
     模糊切片 + 暗幕（强度与 dock 一致，DockPrefs）。壁纸/暗幕视图由代码填充。
     导航卡为独立小卡片，与音乐卡之间保留 12dp 间距；圆角由代码同半径裁剪。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 导航快捷入口卡：回家 / 回单位（地址与地图 App 在设置页配置） -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_nav_card"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="回家"
                android:textColor="#FFF5F5F7"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWork"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_work" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="回单位"
                android:textColor="#FFF5F5F7"
                android:textSize="14sp" />
            </LinearLayout>
    </LinearLayout>

    <!-- 导航卡与音乐卡间距 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- 音乐卡容器（壁纸切片 + 暗幕 + 媒体内容；垂直方向布局紧凑） -->
    <FrameLayout
        android:id="@+id/musicCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/dashWallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <View
            android:id="@+id/dashScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.35" />

            <!-- 专辑封面（有封面时显示，圆角由代码裁剪） -->
            <ImageView
                android:id="@+id/dashCover"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="10dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 静态小标题不能写「正在播放」：它不随状态变化，会和下方状态文案
                 （「未在播放」/「无法读取播放信息」）直接矛盾（2026-10-19 截图实测）。
                 中性的「媒体」标签，具体状态交给标题/副标题两行表达。 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="媒体"
                android:textColor="#FFE0E0E5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dashMediaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="未在播放"
                android:textColor="#FFF5F5F7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashMediaArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="媒体信息未连接"
                android:textColor="#FFE0E0E5"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dashPrev"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_prev" />

                <ImageView
                    android:id="@+id/dashPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_play" />

                <ImageView
                    android:id="@+id/dashNext"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_next" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/dashMediaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progressDrawable="@drawable/bg_media_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dashMediaTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:text="0:00 / 0:00"
                android:textColor="#FFE0E0E5"
                android:textSize="11.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
